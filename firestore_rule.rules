rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isApproved() {
      return request.auth != null && userDoc().status == "approved";
    }
    function isAdmin() {
      return request.auth != null && userDoc().isAdmin == true;
    }
    function keepsPrivileged() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['status', 'isAdmin', 'canPostAsOther', 'annualMember']);
    }

    // 닉네임은 화면 곳곳에 렌더된다. 지금까지는 register.js 의 정규식이
    // 유일한 방어선이었는데, 콘솔에서 직접 쓰면 그냥 통과했다.
    // 렌더 지점 한 곳만 이스케이프를 놓쳐도 XSS 가 되므로 서버에서도 막는다.
    function validNickname() {
      return request.resource.data.nickname is string
        && request.resource.data.nickname.size() > 0
        && request.resource.data.nickname.size() <= 12
        && request.resource.data.nickname.matches('^[가-힣ㄱ-ㅎㅏ-ㅣa-zA-Z0-9 ._-]+$');
    }

    match /users/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.status == "pending"
        && request.resource.data.isAdmin == false
        && validNickname();
      allow update: if isAdmin()
        || (request.auth.uid == uid && keepsPrivileged()
            && (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['nickname']) || validNickname()));
      allow delete: if isAdmin() || request.auth.uid == uid;
    }

    // 참석 신청/취소는 attendees 만, 그것도 "본인 uid 하나"만 넣고 뺄 수 있다.
    // hasOnly(['attendees']) 만으로는 키만 검사해서, 값을 통째로 바꿔치기할 수 있었다
    // (정원 초과, 남을 명단에서 제거, 마감된 일정 끼어들기 전부 통과했다).
    // 아래 두 줄이 각각 "본인 외 추가 없음" / "본인 외 제거 없음" 을 강제한다.
    function onlySelfAttendance() {
      return request.resource.data.attendees
               .hasOnly(resource.data.attendees.concat([request.auth.uid]))
        && resource.data.attendees
               .hasOnly(request.resource.data.attendees.concat([request.auth.uid]));
    }

    // comments 는 authorUid 를 검증하는데 posts 는 빠져 있었다.
    // canPostAsOther 를 가진 사람만 남의 명의로 쓸 수 있다(write.js 의 대리작성 기능).
    // notice 는 관리자 전용이다 — 예전엔 아무나 type 만 바꿔 공지를 만들 수 있었다.
    function validPostAuthor() {
      return request.resource.data.authorUid == request.auth.uid
        || userDoc().canPostAsOther == true;
    }
    function validPostType() {
      return request.resource.data.type == "event" || isAdmin();
    }

    match /posts/{postId} {
      allow read: if isApproved();
      allow create: if isApproved() && validPostAuthor() && validPostType();
      allow update: if isAdmin()
        || (request.auth.uid == resource.data.authorUid
            && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.type == resource.data.type)
        || (isApproved()
            && request.resource.data.diff(resource.data)
                 .affectedKeys().hasOnly(['attendees'])
            && onlySelfAttendance());
      allow delete: if isAdmin() || request.auth.uid == resource.data.authorUid;
    }

    match /comments/{commentId} {
      allow read: if isApproved();
      allow create: if isApproved()
        && request.resource.data.authorUid == request.auth.uid;
      allow update: if false;   // 댓글 수정 기능 없음 — 명시해 둔다
      allow delete: if isAdmin() || request.auth.uid == resource.data.authorUid;
    }

    match /admin_logs/{logId} {
      allow read, create: if isAdmin();
    }

    match /stats/{docId} {
      allow read: if request.auth != null;
      allow write: if isApproved();
    }

    match /monthly_stats/{docId} {
      allow read, write: if isAdmin();
    }

    match /game_scores/{uid} {
      allow read: if request.auth != null;
      allow write: if isApproved() && request.auth.uid == uid
        && request.resource.data.bestScore is int
        && request.resource.data.bestScore >= 0
        && request.resource.data.bestScore <= 100000;
    }

    match /suika_scores/{uid} {
      allow read: if request.auth != null;
      allow write: if isApproved() && request.auth.uid == uid
        && request.resource.data.best is int
        && request.resource.data.best >= 0
        && request.resource.data.best <= 20000;
    }

    match /ratings/{ratingId} {
      allow read: if request.auth != null;
      allow create: if isApproved()
        && request.resource.data.raterUid == request.auth.uid
        && ratingId == request.resource.data.postId + "_" + request.resource.data.raterUid + "_" + request.resource.data.targetUid;
      allow update, delete: if false;
    }

    match /parties/{partyId} {
      allow read, update, delete: if request.auth != null
        && (isAdmin() || request.auth.uid == resource.data.ownerUid);
      allow create: if isApproved()
        && (isAdmin() || request.auth.uid == request.resource.data.ownerUid);
    }
  }
}
